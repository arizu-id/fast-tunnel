# Fast Tunnel — Disable direct web execution of PHP scripts in plugins directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
